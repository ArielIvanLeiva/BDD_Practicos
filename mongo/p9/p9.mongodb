// 4
db.runCommand({
  collMod: "movies",
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["title", "year"],
      properties: {
        title: {
          bsonType: "string",
        },
        year: {
          bsonType: "int",
          minimum: 1900,
          maximum: 3000
        },
        cast: {
          bsonType: "array",
          uniqueItems: true,
          items: {
            bsonType: "string"
          }
        },
        directors: {
          bsonType: "array",
          uniqueItems: true,
          items: {
            bsonType: "string"
          }
        },
        countries: {
          bsonType: "array",
          uniqueItems: true,
          items: {
            bsonType: "string"
          }
        }
      },
    },
  },
})

