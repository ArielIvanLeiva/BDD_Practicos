// 1
// Especificar en la colección users las siguientes reglas de validación:
// El campo name (requerido) debe ser un string con un máximo de 30 caracteres,
// email (requerido) debe ser un string que matchee con la expresión regular: "^(.*)@(.*)\\.(.{2,4})$" , password
// (requerido) debe ser un string con al menos 50 caracteres.
db.runCommand({
  collMod: "users",
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["name", "email", "password"],
      properties: {
        name: {
          bsonType: "string",
          maxLength: 30,
          description: "Name of the user. Must have length less or equal 30.",
        },
        email: {
          bsonType: "string",
          pattern: "^(.*)@(.*)\\.(.{2,4})$",
          description: "User email. Must satisfy the email format :-).",
        },
        password: {
          bsonType: "string",
          minLength: 50,
          description: "User password. Don't put your mom's name.",
        },
      },
    },
  },
});

// Casos buenos
db.users.insertMany([
  {
    name: "Ned Stork",
    email: "asd@fwwef.com",
    password:
      "oooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooo",
  },
  {
    name: "Flaco",
    email: "flaco@gordo.noes",
    password:
      "holaholaholaholaholaholaholaholaholaholaholaholaholaholaholaholaholaholaholaholaholaholaholahola",
  },
]);

// Casos malos
db.users.insertMany([
  {
    email: "asd@ef.com",
    password:
      "oooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooo",
  },
  {
    name: "Flaco",
    email: "flacogordo.noes",
    password:
      "holaholaolaholaholaholaholaholaholaholaholaholaholaholaholaholaholaholaholaholaholaholaholahola",
  },
]);

db.users.deleteMany({ email: "asd@fwwef.com" });

db.users.findOne();

// 2
db.getCollectionInfos({ name: "users" });

// 3
db.runCommand({
  collMod: "theaters",
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["theaterId", "location"],
      properties: {
        theaterId: {
          bsonType: "int",
          description: "Id of the theater.",
        },
        location: {
          bsonType: "object",
          required: ["address"],
          properties: {
            address: {
              bsonType: "object",
              required: ["street1", "city", "state", "zipcode"],
              properties: {
                street1: {
                  bsonType: "string",
                },
                city: {
                  bsonType: "string",
                },
                state: {
                  bsonType: "string",
                },
                zipcode: {
                  bsonType: "string",
                },
              },
            },
            geo: {
              bsonType: "object",
              properties: {
                type: {
                  enum: ["Point", null],
                },
                coordinates: {
                  bsonType: "array",
                  minItems: 2,
                  maxItems: 2,
                  items: {
                    bsonType: "double",
                  },
                },
              },
            },
          },
        },
      },
    },
  },
  validationAction: "warn",
});

db.getCollectionInfos({ name: "theaters" });
db.theaters.findOne();

