db.createCollection("comments");
db.runCommand({
  collMod: "comments",
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["user_id", "article_id", "date", "text"],
      properties: {
        user_id: {
          bsonType: "objectId",
        },
        article_id: {
          bsonType: "objectId",
        },
        date: {
          bsonType: "date",
        },
        text: {
          bsonType: "string",
        },
      },
    },
  },
});

db.createCollection("articles");
db.runCommand({
  collMod: "articles",
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["user_id", "title", "date", "text", "url"],
      properties: {
        user_id: {
          bsonType: "objectId",
        },
        title: {
          bsonType: "string",
        },
        date: {
          bsonType: "date",
        },
        text: {
          bsonType: "string",
        },
        url: {
          bsonType: "string",
        },
        categories: {
          bsonType: "array",
          items: {
            bsonType: "object",
            required: ["category_id", "name"],
            properties: {
              // OJO CON ESTO, PUEDE SER IMPORTANTE TENER EL ID
              category_id: {
                bsonType: "objectId",
              },
              name: {
                bsonType: "string",
              },
            },
          },
        },
        tags: {
          bsonType: "array",
          items: {
            bsonType: "object",
            required: ["tag_id", "name"],
            properties: {
              // OJO CON ESTO, PUEDE SER IMPORTANTE TENER EL ID
              tag_id: {
                bsonType: "objectId",
              },
              name: {
                bsonType: "string",
              },
            },
          },
        },
      },
    },
  },
});

db.getCollectionInfos();
