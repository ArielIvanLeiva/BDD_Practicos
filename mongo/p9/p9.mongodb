// I.
db.books.aggregate({
  $group: {
    _id: "$author",
    books: {
      $addToSet: {
        _id: "$_id",
        title: "$title",
        price: "$price",
        category: "$category",
      },
    },
  },
});

// II.
db.books.aggregate({
  $group: {
    _id: "$category.category_id",
    category_name: { $first: "$category.category_name" },
    num_of_books: { $sum: 1 },
  },
});

// III.
const order_id = ObjectId("67278b2ebcdfef32922b93ce");
db.orders.aggregate([
  {
    $match: {
      _id: order_id,
    },
  },
  {
    $addFields: {
      total_prices: {
        $map: {
          input: "$order_details",
          as: "order_detail",
          in: {
            $multiply: ["$$order_detail.price", "$$order_detail.quantity"],
          },
        },
      },
    },
  },
  {
    $project: {
      delivery_name: 1,
      delivery_address: 1,
      total_price: {
        $sum: "$total_prices",
      },
    },
  },
]);

const order_id = ObjectId("67278b2ebcdfef32922b93ce");
db.orders.aggregate([
  {
    $match: {
      _id: order_id,
    },
  },
  {
    $project: {
      total_prices: {
        $map: {
          input: "$order_details",
          as: "order_detail",
          in: {
            $multiply: ["$$order_detail.price", "$$order_detail.quantity"],
          },
        },
      },
    },
  },
]);

