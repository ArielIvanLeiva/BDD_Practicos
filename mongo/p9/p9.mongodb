// 5
db.createCollection("userProfiles");
db.getCollectionNames();

db.runCommand({
  collMod: "userProfiles",
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["user_id", "language"],
      properties: {
        user_id: {
          bsonType: "objectId",
        },
        language: {
          enum: ["English", "Spanish", "Portuguese"],
        },
        favorite_genres: {
          bsonType: "array",
          uniqueItems: true,
          items: {
            bsonType: "string",
          },
        },
      },
    },
  },
});

// Casos buenos
