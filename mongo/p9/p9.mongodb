// En general las relaciones entre movies y comments son One-To-Many, representando la misma
// a través del atributo "movie_id" dentro de un comentario, que "referencia" (semánticamente)
// a una película (que al menos semánticamente se supone unívocamente determinada).

// 7
use("shop");

db.createCollection("orders");
// Por si quisieramos borrar/deleteear/dropear la collección
db.orders.drop();

db.runCommand({
  collMod: "orders",
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: [
        "delivery_name",
        "delivery_address",
        "cc_name",
        "cc_number",
        "cc_expiry",
      ],
      properties: {
        delivery_name: {
          bsonType: "string",
          maxLength: 70,
        },
        delivery_address: {
          bsonType: "string",
          maxLength: 70,
        },
        cc_name: {
          bsonType: "string",
          maxLength: 70,
        },
        cc_number: {
          bsonType: "string",
          maxLength: 32,
        },
        cc_expiry: {
          bsonType: "string",
          maxLength: 20,
        },
        order_details: {
          bsonType: "array",
          uniqueItems: true,
          items: {
            bsonType: "object",
            required: ["book_id", "title", "author", "quantity", "price"],
            properties: {
              book_id: {
                bsonType: "objectId",
              },
              title: {
                bsonType: "string",
                maxLength: 70,
              },
              author: {
                bsonType: "string",
                maxLength: 70,
              },
              quantity: {
                bsonType: "int",
              },
              price: {
                bsonType: "double",
              },
            },
          },
        },
      },
    },
  },
});

db.createCollection("order_details");
db.runCommand({
  collMod: "order_details",
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["book_id", "title", "author", "quantity", "price"],
      properties: {
        book_id: {
          bsonType: "int",
        },
        title: {
          bsonType: "string",
          maxLength: 70,
        },
        author: {
          bsonType: "string",
          maxLength: 70,
        },
        quantity: {
          bsonType: "int",
        },
        price: {
          bsonType: "double",
        },
      },
    },
  },
});

db.createCollection("books");

db.runCommand({
  collMod: "books",
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["title", "author", "price", "category"],
      properties: {
        title: {
          bsonType: "string",
          maxLength: 70,
        },
        author: {
          bsonType: "string",
          maxLength: 70,
        },
        price: {
          bsonType: "double",
        },
        category: {
          bsonType: "object",
          required: ["category_id", "category_name"],
          properties: {
            category_id: {
              bsonType: "objectId",
            },
            category_name: {
              bsonType: "string",
              maxLength: 70,
            },
          },
        },
      },
    },
  },
});

db.getCollectionNames();

