// 9
db.createView("most_messaged_genres", "comments", {
  pipeline: [
    {
      $unwind: "$genres",
    },
    {
      $group: {
        _id: "$genres",
      },
    },
    {
      $limit: 10,
    },
  ],
});

// Forma ineficiente
db.movies.aggregate([
  {
    $unwind: "$genres"
  },
  {
    $project: {
      genre: "$genres"
    }
  },
  {
    $lookup: {
      from: "comments",
      localField: "_id",
      foreignField: "movie_id",
      as: "comments",
    }
  },
  {
    $unwind: "$comments"
  },
  {
    $group: {
      _id: "$genre",
      num_of_comments: { $sum: 1 }
    }
  },
  {
    $sort: { num_of_comments: -1 }
  }
]);

db.movies.aggregate([
  {
    $unwind: "$genres"
  },
  {
    $project: {
      genre: "$genres"
    }
  },
  {
    $lookup: {
      from: "comments",
      localField: "_id",
      foreignField: "movie_id",
      as: "comments",
    }
  },
  {
    $unwind: "$comments"
  },
  {
    $group: {
      _id: "$genre",
      num_of_comments: { $sum: 1 }
    }
  },
  {
    $sort: { num_of_comments: -1 }
  },
  {
    $limit: 10
  }
]);

db.comments.findOne();


// 10 
db.movies.aggregate(
  [
    {
      $unwind: "$cast"
    },
    {
      $match: {
        directors: {$elemMatch: { $eq: "Jules Bass"}}
      }
    },
    {
      $group: {
        _id: "$cast",
        movies: { $addToSet: {title: "$title", year: "$year"} }
      }
    },
    {
      $match: {
        "movies.1": {$exists: true}
      }
    }
  ]
);

db.movies.findOne()

// 11
db.comments.aggregate({
  $lookup: {
    from: "movies",
    localField: "movie_id",
    foreignField: "_id",
    // PREGUNTAR
    pipeline: [
      {
        $match: {
          $expr: {
            $and: [
              { $eq: [{ $month: "$date" }, { $month: "$$ROOT.date" }] },
              { $eq: [{ $year: "$date" }, { $year: "$$ROOT.date" }] },
            ],
          },
        },
      },
    ],
    as: "movie",
  },
});

db.comments.findOne()
db.movies.findOne()

// 12

// a. Resolver con $group y accumulators
db.restaurants.aggregate([
  {
    $unwind: "$grades"
  },
  {
    $group: {
      _id: {_id: "$_id", name: "$name"},  // PREGUNTAR
      max_score: { $max: "$grades.score" },
      min_score: { $min: "$grades.score" },
      sum_score: { $sum: "$grades.score" }
    }
  },
  {
    $project: {
      _id: "$_id._id",
      name: "$_id.name",
      max_score: 1,
      min_score: 1,
      sum_score: 1

    },
  },
]);

// b. Resolver con expresiones sobre arreglos (por ejemplo, $sum) pero sin $group.
db.restaurants.aggregate([
  {
    $project: {
      _id: 1,
      name: 1,
      max_score: { $max: "$grades.score" },
      min_score: { $min: "$grades.score" },
      sum_score: { $sum: "$grades.score" },
    },
  },
]);

// c. Resolver como en el punto b) pero usar $reduce para calcular la puntuación total
db.restaurants.aggregate([
  {
    $project: {
      _id: 1,
      name: 1,
      max_score: { $max: "$grades.score" },
      min_score: { $min: "$grades.score" },
      sum_score: {
        $reduce: {
          input: "$grades",
          initialValue: 0,
          in: {
            $add: ["$$value", "$$this.score"],
          }
        },
      },
    },
  },
]);

// d. Resolver con find
db.restaurants.find(
  {},
  {
    _id: 1,
    name: 1,
    max_score: { $max: "$grades.score" },
    min_score: { $min: "$grades.score" },
    sum_score: { $sum: "$grades.score" },
  }
);

db.restaurants.findOne()

// 13.
db.restaurants.updateMany({}, [
  {
    $set: {
      average_score: { $avg: "$grades.score" },
    },
  },
  {
    $set: {
      grade: {
        $cond: [
          { $and: [{ $gte: ["$score", 0] }, { $lte: ["$score", 13] }] },
          "A",
          {
            $cond: [
              { $and: [{ $gte: ["$score", 14] }, { $lte: ["$score", 27] }] },
              "B",
              "C"
            ],
          },
        ],
      },
    },
  },
]);

db.restaurants.findOne()