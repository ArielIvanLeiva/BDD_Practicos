// ------------------------------------
// 1
db.theaters.aggregate([
  {
    $group: {
      _id: "$location.address.state",
      theaters_count: { $sum: 1 },
    },
  },
  // NOTA: Agregué este sort
  // porque parece ser que el orden default es no determinístico
  { $sort: { theaters_count: 1 } },
]);

db.theaters.findOne();
// ------------------------------------
// 2
db.theaters.aggregate([
  {
    $group: {
      _id: "$location.address.state",
      theaters_count: { $sum: 1 },
    },
  },
  // NOTA: Agregué este sort
  // porque parece ser que el orden default es no determinístico
  { $sort: { theaters_count: 1 } },
  {
    $match: {
      theaters_count: { $gte: 2 },
    },
  },
]);

// ------------------------------------
// 3

// Sin pipeline
db.movies.countDocuments({
  directors: { $elemMatch: { $eq: "Louis Lumière" } },
});

// Con pipeline
db.movies.aggregate([
  {
    $match: {
      directors: { $elemMatch: { $eq: "Louis Lumière" } },
    },
  },
  {
    $count: "num_of_movies",
  },
]);

db.movies.findOne();

// ------------------------------------
// 4

// Sin pipeline
db.movies.countDocuments({
  year: { $gte: 1950, $lte: 1959 },
});

// Con pipeline
db.movies.aggregate([
  {
    $match: {
      year: { $gte: 1950, $lte: 1959 },
    },
  },
  {
    $count: "num_of_movies",
  },
]);

// ------------------------------------
// 5
db.movies.aggregate(
  {
    $unwind: "$genres",
  },
  {
    $group: {
      _id: "$genres",
      num_of_movies: { $sum: 1 },
    },
  },
  {
    $sort: { num_of_movies: -1 },
  },
  {
    $limit: 10,
  }
);

// ------------------------------------
// 6
db.comments.aggregate(
  {
    $group: {
      _id: { email: "$email", name: "$name" },
      num_of_comments: { $sum: 1 },
    },
  },
  {
    $project: {
      _id: 0,
      name: "$_id.name",
      email: "$_id.email",
      num_of_comments: 1,
    },
  },
  {
    $sort: { num_of_comments: -1 },
  },
  {
    $limit: 10,
  }
);

db.comments.findOne();
db.users.findOne();
// ------------------------------------
// 7
db.movies.aggregate(
  {
    $match: {
      year: { $gte: 1980, $lte: 1989 },
      // Agrego esto para asegurarme que el rating es un número
      "imdb.rating": { $type: ["double", "int"] },
    },
  },
  {
    $group: {
      _id: "$year",
      avg_rating: { $avg: "$imdb.rating" },
      min_rating: { $min: "$imdb.rating" },
      max_rating: { $max: "$imdb.rating" },
    },
  },
  {
    $sort: { avg_rating: -1 },
  }
);

db.movies.findOne();

// ------------------------------------
// 8
db.comments.aggregate(
  {
    $group: {
      _id: { movie_id: "$movie_id" },
      num_of_comments: { $sum: 1 },
    },
  },
  {
    $lookup: {
      from: "movies",
      localField: "_id.movie_id",
      foreignField: "_id",
      as: "movie",
    },
  },
  {
    $unwind: "$movie",
  },
  {
    $project: {
      _id: 0,
      title: "$movie.title",
      year: "$movie.year",
      num_of_comments: 1,
    },
  },
  {
    $sort: { num_of_comments: -1 },
  }
);

// ------------------------------------
// 9
db.createView("most_messaged_genres", "comments", {
  pipeline: [
    {
      $unwind: "$genres",
    },
    {
      $group: {
        _id: "$genres",
      },
    },
    {
      $limit: 10,
    },
  ],
});

// Forma ineficiente
db.movies.aggregate([
  {
    $unwind: "$genres"
  },
  {
    $project: {
      genre: "$genres"
    }
  },
  {
    $lookup: {
      from: "comments",
      localField: "_id",
      foreignField: "movie_id",
      as: "comments",
    }
  },
  {
    $unwind: "$comments"
  },
  {
    $group: {
      _id: "$genre",
      num_of_comments: { $sum: 1 }
    }
  },
  {
    $sort: { num_of_comments: -1 }
  }
]);

db.movies.aggregate([
  {
    $unwind: "$genres"
  },
  {
    $project: {
      genre: "$genres"
    }
  },
  {
    $lookup: {
      from: "comments",
      localField: "_id",
      foreignField: "movie_id",
      as: "comments",
    }
  },
  {
    $unwind: "$comments"
  },
  {
    $group: {
      _id: "$genre",
      num_of_comments: { $sum: 1 }
    }
  },
  {
    $sort: { num_of_comments: -1 }
  },
  {
    $limit: 10
  }
]);

db.comments.findOne();


// 10
db.movies.aggregate(
  [
    {
      $unwind: "$cast"
    },
    {
      $match: {
        directors: {$elemMatch: { $eq: "Jules Bass"}}
      }
    },
    {
      $group: {
        _id: "$cast",
        movies: { $addToSet: {title: "$title", year: "$year"} }
      }
    },
    {
      $match: {
        "movies.1": {$exists: true}
      }
    }
  ]
);

db.movies.findOne()

// 11
db.comments.aggregate({
  $lookup: {
    from: "movies",
    localField: "movie_id",
    foreignField: "_id",
    pipeline: [
      {
        $match: {
          $and: [
            { $eq: [{ $month: "$date" }, { $month: "$$ROOT.date" }] },
            { $eq: [{ $year: "$date" }, { $year: "$$ROOT.date" }] },
          ],
        },
      },
    ],
    as: "movie",
  },
});

db.comments.findOne()